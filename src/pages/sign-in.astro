---
import { SignIn } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getConfiguredSiteUrl, resolveAuthOrigin } from '../lib/env';
const authOrigin = resolveAuthOrigin(Astro.url, getConfiguredSiteUrl());
const dashboardUrl = new URL('/dashboard', `${authOrigin}/`).toString();
const { userId } = Astro.locals.auth();
if (userId) return Astro.redirect(dashboardUrl);
---
<BaseLayout title="כניסה"><main class="auth"><section class="context"><div class="logo">S</div><p class="eyebrow">STSICONIC</p><h1>המספרים של העסק.<br/>במקום אחד.</h1><p>לוח בקרה פיננסי מדויק שמחבר את נתוני Google Sheets לתמונה עסקית ברורה.</p><ul><li>נתונים לקריאה בלבד</li><li>חיבור מאובטח ומוצפן</li><li>תובנות בזמן אמת</li></ul></section><section class="signin"><div><p class="mobile-brand">STSICONIC</p><h2>טוב שחזרת</h2><p>התחברו כדי להמשיך ללוח הבקרה</p><SignIn path="/sign-in" routing="path" forceRedirectUrl={dashboardUrl} signUpForceRedirectUrl={dashboardUrl} appearance={{variables:{colorPrimary:'#22D3EE',colorBackground:'#0D1B2A',colorText:'#F4F8FC',colorTextSecondary:'#A9B9C9',colorInputBackground:'#122337',colorInputText:'#F4F8FC',borderRadius:'10px'},elements:{rootBox:'clerk-root',card:'clerk-card'}}}/></div></section></main></BaseLayout>
<style>.auth{min-height:100vh;display:grid;grid-template-columns:1fr 1fr}.context{display:flex;flex-direction:column;justify-content:center;padding:clamp(40px,8vw,128px);background:var(--bg-sidebar);border-left:1px solid var(--border)}.logo{display:grid;place-items:center;width:48px;height:48px;border-radius:12px;background:var(--accent);color:var(--bg-canvas);font-weight:800;font-size:26px}.eyebrow{color:var(--accent);font-weight:700;letter-spacing:.15em}.context h1{font-size:clamp(34px,4vw,56px);line-height:1.15;margin:16px 0}.context>p:not(.eyebrow){max-width:500px;color:var(--text-secondary);line-height:1.8}.context ul{list-style:none;padding:0;display:grid;gap:12px;color:var(--text-secondary)}.context li:before{content:'✓';color:var(--positive);margin-left:10px}.signin{display:grid;place-items:center;padding:32px}.signin>div{width:min(100%,420px)}.signin h2{font-size:30px;margin:0}.signin p{color:var(--text-secondary)}.mobile-brand{display:none}:global(.clerk-root),:global(.clerk-card){width:100%!important;box-shadow:none!important}@media(max-width:760px){.auth{display:block}.context{display:none}.signin{min-height:100vh;padding:24px}.mobile-brand{display:block;color:var(--accent)!important;font-weight:700;margin-bottom:48px}}</style>
